<?xml version="1.0" encoding="utf-8"?>
<!-- 光标拖柄（WebView 文本插入手柄 / insertion handle）自绘资源。
     目的：不再使用设备框架自带的 text_select_handle_middle_mtrl_alpha
     —— 该资源在部分机型（如鸿蒙卓易通）上呈现为「未抠背景的绿色水滴」，
     且颜色由机型主题的 colorControlActivated 决定，端上不可控。

     几何尺寸对齐 AOSP 原生手柄（mdpi 20x24px，即 20dp x 24dp）：
     尖端位于顶部中央并指向光标，下方为直径 20dp 的圆头；
     路径 = 尖端 → 右侧切点 → 270° 圆弧（右→下→左）→ 左侧切点 → 闭合。
     背景完全透明，填充色取 @color/profer_accent（Profer 品牌蓝，day/night 同值）。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="24dp"
    android:viewportWidth="20"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/profer_accent"
        android:pathData="M10,0 L17.0,6.86 A10,10 0 1 1 3.0,6.86 Z" />
</vector>
