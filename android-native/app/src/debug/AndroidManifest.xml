        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.profer.pocket.DEBUG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
